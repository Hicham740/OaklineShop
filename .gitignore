.env
.env.local
.env.*.local
!.env.example
backend/.env
frontend/.env.local

# ── Builds / output ──
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel

# ── Logs / debug ──npm install next@16.4.2npm install nenpm install next@16.4.2npm install next@16.4.2xt@16.4.2
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ── OS / editor ──
.DS_Store
*.pem
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── Local database files ──
*.db
*.db-journal

# ── Uploads / temp (local only) ──
uploads/
tmp/
.tmp/
*.tmp
