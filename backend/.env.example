# ── Backend env template ──
# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env

# App
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
# e.g. postgresql://oakline:oakline@localhost:5432/oakline
DATABASE_URL=postgresql://oakline:oakline@localhost:5432/oakline

# Auth — used by `npm run db:seed` to create/reset the privileged admin account.
# Customers create their own accounts at /signup. The API uses database-backed
# session cookies, so no JWT secret is needed.
ADMIN_EMAIL=admin@oakline.test
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Store admin

# CORS — comma-separated storefront origins allowed to call this API.
# In development, any localhost/127.0.0.1 port is also accepted so Next.js can
# switch to 3001, 3002, etc. when 3000 is busy.
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Payments (optional, for ecommerce checkout)
# STRIPE_SECRET_KEY=sk_test_...
