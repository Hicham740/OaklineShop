# ── Frontend env template ──
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#   cp .env.example .env.local

# Backend API base URL used by the browser (must start with http)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: server-side URL used by the admin and account layouts to validate
# the session. Defaults to NEXT_PUBLIC_API_URL when omitted.
API_URL=http://localhost:4000

# Public app URL (used for metadata, canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (optional, publishable key only — never a secret key here)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
